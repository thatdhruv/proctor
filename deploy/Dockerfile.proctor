# Runner image: C++ core + Python package. Used by docker-compose and the evidence scripts.
FROM ubuntu:22.04 AS build
RUN apt-get update && apt-get install -y --no-install-recommends g++ make && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY core/ core/
RUN make -C core -j"$(nproc)" BUILD=/opt/proctor/bin

FROM ubuntu:22.04
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip python3-venv git ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /opt/proctor/bin /opt/proctor/bin
COPY python /opt/proctor/python
COPY core/tests /opt/proctor/core/tests
RUN pip install --no-cache-dir /opt/proctor/python pytest
ENV PROCTOR_CORE_BUILD=/opt/proctor/bin
WORKDIR /opt/proctor
ENTRYPOINT ["proctor"]
CMD ["--help"]
